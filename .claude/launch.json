{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "cirp-frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "frontend", "run", "dev"],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "cirp-backend",
      "runtimeExecutable": "bash",
      "runtimeArgs": [
        "-c",
        "cd backend && source .venv/bin/activate && uvicorn app.main:app --reload --port ${PORT:-8000}"
      ],
      "port": 8000,
      "autoPort": true
    }
  ]
}
